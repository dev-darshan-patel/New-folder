# Copy to .env and fill in. Postgres (Neon / Vercel Postgres) is required —
# see docs/deploy.md for how to get a free connection string in ~2 minutes.
#
# DATABASE_URL: pooled connection (PgBouncer) — used by the app at runtime.
# DIRECT_URL:   unpooled connection — used only by `prisma migrate`.
# Vercel's Postgres/Neon integration sets POSTGRES_PRISMA_URL and
# POSTGRES_URL_NON_POOLING automatically; if you use it, point these two at
# those instead of retyping the connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# AES-256-GCM key encrypting secrets at rest in the database: TOTP 2FA
# secrets, and Google/Zoom OAuth refresh tokens. REQUIRED in production —
# the app refuses to store these in plaintext without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters. Back this up outside the database:
# losing it makes every already-encrypted row unrecoverable, and changing it
# later means old rows can no longer be decrypted with the new key.
ENCRYPTION_KEY="change-me-to-64-hex-characters"

# Base URL used when building public booking links and email content.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# White-labeling: the product's own name (wordmarks, page titles, favicon
# letter, calendar PRODID, default email From-name). Leave unset to keep
# "Bookify". See REBRANDING.md — most of the app follows this automatically,
# but a couple of things (the two HTML guides in public/, and the TOTP 2FA
# issuer name already baked into existing tenants' authenticator apps) need
# a one-time manual step.
NEXT_PUBLIC_PRODUCT_NAME=""

# SMTP for outgoing email. Leave SMTP_HOST blank to log emails to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Falls back to "${NEXT_PUBLIC_PRODUCT_NAME} <no-reply@example.com>" if unset.
SMTP_FROM=""

# Stripe billing is primarily configured at runtime via the platform admin
# console (/admin/settings), which stores test AND live credentials in the
# database and lets a Super Admin switch between them without redeploying.
# These env vars are only a zero-config fallback for TEST mode and are
# ignored once a key is set in /admin/settings.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Secret protecting the reminder cron endpoint (/api/cron/reminders).
CRON_SECRET="change-me"

# Structured (pino) log verbosity: fatal, error, warn, info, debug, trace.
# Defaults to "debug" in development and "info" in production.
LOG_LEVEL=""

# File storage for user uploads (currently just avatars) is primarily
# configured live at /admin/settings/storage (DB-backed, same pattern as
# Stripe) — these env vars are only a zero-config fallback used when the DB
# fields are empty. Three backends — see src/lib/storage/. Auto-detected from
# whichever set of vars below is populated (S3 wins if both are set); leave
# everything blank for the local-disk dev fallback (writes into
# public/uploads/, doesn't persist on most serverless hosts). Set
# STORAGE_PROVIDER explicitly ("s3" | "vercel-blob" | "local") to override
# auto-detection.
STORAGE_PROVIDER=""

# Vercel Blob. Vercel sets BLOB_READ_WRITE_TOKEN automatically when you attach
# a Blob store to the project; BLOB_STORE_ID is only needed for a non-default store.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# S3 or an S3-compatible provider — AWS S3, Cloudflare R2, DigitalOcean
# Spaces, Backblaze B2, MinIO. Leave S3_ENDPOINT unset for real AWS S3; set
# it to the provider's endpoint for everything else. S3_PUBLIC_URL_BASE is
# the URL prefix uploads are served from — required for R2/Spaces, which
# don't serve bucket contents over plain HTTPS by default (use a custom
# domain or public-bucket URL). S3_FORCE_PATH_STYLE is needed for MinIO and
# some self-hosted setups.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL_BASE=""
S3_FORCE_PATH_STYLE=""

# Standard Node environment flag. Next.js sets this itself for `next build`/
# `next start` — you shouldn't need to set it manually. A few things key off
# it explicitly, e.g. ENCRYPTION_KEY above is only hard-required when this is
# "production".
NODE_ENV=""
